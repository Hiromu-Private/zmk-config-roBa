#!/bin/bash
# roba-log — 打鍵タイミング計測の開始/停止/確認
#
#   roba-log build    ビルドして ~/.local/bin/roba-keylog へインストール
#   roba-log start    計測開始（LaunchAgent 登録・再ログイン後も継続）
#   roba-log permit   「入力監視」の許可設定を開く
#   roba-log stop     計測停止
#   roba-log status   稼働状況とログ量
#   roba-log report   解析レポートを表示
#   roba-log tail     直近のイベントを流し見
#   roba-log purge    ログを全削除

set -euo pipefail

SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# 素の CLI バイナリは linker-signed ad-hoc（designated requirement 無し）になり、
# TCC が同一性を確立できず「入力監視」の許可が安定して効かない。
# そのため .app バンドルにして正式に ad-hoc 署名する。
APP="$HOME/Applications/RobaKeylog.app"
BIN="$APP/Contents/MacOS/RobaKeylog"
BUNDLE_ID="com.waggy.roba-keylog"
LOG_DIR="$HOME/.local/share/roba-keylog"
LABEL="com.waggy.roba-keylog"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

cmd_build() {
  echo "==> ビルド中..."
  local tmp was_running=0
  tmp="$(mktemp -d)"
  cp "$SRC_DIR/RobaKeylog.swift" "$tmp/main.swift"
  swiftc -O "$tmp/main.swift" -o "$tmp/RobaKeylog"

  local stage="$tmp/RobaKeylog.app"
  mkdir -p "$stage/Contents/MacOS"
  mv "$tmp/RobaKeylog" "$stage/Contents/MacOS/RobaKeylog"
  cat > "$stage/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>RobaKeylog</string>
    <key>CFBundleIdentifier</key><string>$BUNDLE_ID</string>
    <key>CFBundleName</key><string>RobaKeylog</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSUIElement</key><true/>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
</dict>
</plist>
EOF
  codesign --force --sign - --identifier "$BUNDLE_ID" "$stage"
  echo "==> 署名:"
  codesign -dv "$stage" 2>&1 | grep -E "Identifier|Signature" | sed 's/^/    /'

  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
    was_running=1
  fi
  mkdir -p "$HOME/Applications"
  rm -rf "$APP"
  mv "$stage" "$APP"
  rm -rf "$tmp"
  # 旧: 素のバイナリ版が残っていたら消す（TCC のリストに残ると紛らわしい）
  rm -f "$HOME/.local/bin/roba-keylog"
  echo "==> インストール完了: $APP"
  [[ "$was_running" == "1" ]] && { echo "==> 再起動します"; cmd_start; }
  return 0
}

write_plist() {
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$BIN</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardErrorPath</key>
    <string>$LOG_DIR/stderr.log</string>
</dict>
</plist>
EOF
}

cmd_start() {
  [[ -x "$BIN" ]] || { echo "先に 'roba-log build' を実行してください"; exit 1; }
  mkdir -p "$LOG_DIR"
  write_plist
  launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
  launchctl bootstrap "$DOMAIN" "$PLIST"
  echo "==> 計測を開始しました"
  echo
  echo "初回は「入力監視」の許可が必要です（'roba-log permit' で設定画面を開けます）。"
  echo "リストの RobaKeylog を ON にしてください。"
  echo
  sleep 2
  cmd_status
}

cmd_stop() {
  launchctl bootout "$DOMAIN/$LABEL" >/dev/null 2>&1 || true
  echo "==> 計測を停止しました（ログは $LOG_DIR に残ります）"
}

cmd_status() {
  if launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; then
    local pid
    pid="$(launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '/^\tpid = /{print $3}')"
    echo "状態: 稼働中${pid:+ (pid $pid)}"
  else
    echo "状態: 停止中"
  fi
  echo "ログ: $LOG_DIR"
  if [[ -d "$LOG_DIR" ]]; then
    local total=0
    for f in "$LOG_DIR"/*.jsonl; do
      [[ -e "$f" ]] || continue
      local n
      n="$(wc -l < "$f" | tr -d ' ')"
      total=$((total + n))
      printf "  %s  %6s イベント\n" "$(basename "$f")" "$n"
    done
    echo "  合計: $total イベント"
  fi
  if [[ -s "$LOG_DIR/stderr.log" ]]; then
    echo "--- stderr (末尾3行) ---"
    tail -3 "$LOG_DIR/stderr.log"
  fi
}

cmd_permit() {
  echo "「入力監視」の設定画面を開きます。"
  echo
  echo "  1. 古い 'roba-keylog' の項目があれば「−」で削除する"
  echo "  2. 'RobaKeylog' を ON にする"
  echo "     無ければ「+」→ Cmd+Shift+G で次を貼り付け:"
  echo "       $APP"
  echo
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_ListenEvent"
}

cmd_report() { python3 "$SRC_DIR/analyze.py" "$@"; }

cmd_tail() { tail -f "$LOG_DIR/$(date +%F).jsonl"; }

cmd_purge() {
  read -rp "本当に全ログを削除しますか？ [y/N] " ans
  [[ "$ans" == "y" ]] && rm -f "$LOG_DIR"/*.jsonl && echo "削除しました" || echo "中止しました"
}

case "${1:-}" in
  build)  cmd_build ;;
  start)  cmd_start ;;
  permit) cmd_permit ;;
  stop)   cmd_stop ;;
  status) cmd_status ;;
  report) shift; cmd_report "$@" ;;
  tail)   cmd_tail ;;
  purge)  cmd_purge ;;
  *) sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
esac
