#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define MOUSE 4 // 各自のマウスレイヤーに合わせて設定
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100  // #includeのあとのあたりにスクロール量を変更

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&sl { release-after-ms = <250>; };

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    hold-while-undecided;
    hold-while-undecided-linger;
}; // ダブルクリックに必要な時間を設定
&trackball {
    // automouse-layer = <4>;  // コメントアウトしてオートマウスレイヤーを無効化

    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        copy-chatGPT {
            bindings = <&select_copy LG(A) LG(C)>;
            key-positions = <27 26>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <21 20>;
        };

        alfred {
            bindings = <&kp LC(SPACE)>;
            key-positions = <10 38>;
        };

        shift_command_V {
            bindings = <&kp LS(LG(V))>;
            key-positions = <22 37 25>;
        };

        shift_command_C {
            bindings = <&kp LS(LG(C))>;
            key-positions = <22 37 24>;
        };

        shift_command_E {
            bindings = <&kp LS(LG(E))>;
            key-positions = <22 37 2>;
        };

        shift_command_S {
            bindings = <&kp LS(LG(S))>;
            key-positions = <22 37 11>;
        };

        shift_command_D {
            bindings = <&kp LS(LG(D))>;
            key-positions = <22 37 12>;
        };

        apple {
            bindings = <&Apple_macro>;
            key-positions = <18 41 19 20 21>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        browser_back: browser_back {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT_ARROW)>;
            label = "BROWSER_BACK";
        };

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 0>;

            label = "MKP_EXIT_AML";
        };

        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(PLUS)>;
            label = "ZOOM_IN";
        };

        select_copy: SELECT_AND_COPY {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_wait_time 50>,
                <&macro_press>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>;

            label = "SELECT_AND_COPY";
        };

        Apple_macro: apple_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp P &kp P &kp L &kp E &kp N0 &kp N7 &kp N0 &kp N1>;
            label = "apple_MACRO";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // ── 実測に基づくチューニング（2026-08-07）──────────────
        // 2026-08-06 の実測 37,462 イベントから決めた値。根拠:
        //
        //   Z を hold して他キーを打った 271 件は押下時間が二峰性だった。
        //     0-120ms   78 件  相手は R/L  → tap のつもりが hold になった誤爆
        //     120-200ms  9 件  （谷）
        //     200ms 以上 184 件  相手は ENT 125 件 → 意図的な Shift+Enter・大文字
        //   意図的な hold の押下は p50 = 298ms。誤爆と 150ms できれいに切れる。
        //
        // flavor: balanced → tap-preferred
        //   balanced は「他キーを押して離した」時点で tapping-term 内でも hold を
        //   確定させる。誤爆 78 件のうち 62 件がこれで、tapping-term をいくら
        //   伸ばしても救えなかった。tap-preferred は tapping-term を超えるまで
        //   hold にしないので、この層が丸ごと消える。
        //
        // tapping-term-ms: 100 → 150
        //   素の物理キーの押下は p50 64ms / p90 104ms。100 では通常打鍵の
        //   11.7% が hold 側に落ちる。150 なら 1.5%。
        //
        // hold-while-undecided を削除
        //   押した瞬間に Shift がホストへ漏れ、tap 成立時も LSFT の down/up が
        //   macOS に届いていた（実測 98 件）。ことえりへの余計な Shift を止める。
        //
        // ※ position 34 は計測用に RIGHT_SHIFT のまま（macOS 上の機能は同じ）。
        //   Before/After を比べるため、効果確認が済むまで戻さない。
        // ──────────────────────────────────────────────────────
        mt_z_custom: mt_z_custom {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_Z_CUSTOM";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            quick-tap-ms = <0>;
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;

            retro-tap;
            hold-trigger-key-positions = <37 24 13 11 25 5 6 7 8 19 20 18 16 17 28 29 30 31 32 9 21 33 1 2 4 3 12 14 27 26 23 15 0 10 34 35 36 38 39 40 41>;
        };

        // 新しいスクロール動作の追加

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            // 追加: スクロールのタップ時間を設定 (20ms)

            tap-ms = <20>;
        };

        mt_comand_custom: mt_comand_custom {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_COMAND_CUSTOM";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <0>;
            hold-trigger-key-positions = <22 10 36>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
            label = "NEW_BEHAVIOR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 6 Q                    &kp W         &kp E         &kp R                                 &kp T                                     &kp Y                    &kp U  &kp I     &kp O     &kp P
&mt LEFT_CONTROL A         &kp S         &kp D         &kp F                                 &kp G        &mkp MB3        &kp MINUS    &kp H                    &kp J  &kp K     &kp L     &lt 5 ENTER
&mt_z_custom LEFT_SHIFT Z  &kp X         &kp C         &kp V                                 &kp B        &kp PERIOD      &kp COMMA    &kp N                    &kp M  &mkp MB1  &mkp MB2  &kp BACKSPACE
&kp RIGHT_SHIFT            &kp LEFT_WIN  &kp LEFT_ALT  &mt_comand_custom LEFT_COMMAND LANG2  &lt 2 SPACE  &lt 8 TAB       &lt 3 SPACE  &mt RIGHT_COMMAND LANG1                             &kp ESC
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        // ⚠ このレイヤーへの到達手段はキーマップ中に存在しない（呼び出す
        //    `&mo 1` / `&lt 1` / `&to 1` が1つも無い）。F キーは layer_8 へ移した。
        //    レイヤー番号は定義順で決まり、削除すると以降の `&lt 2` 等が全部ずれる
        //    ため、定義自体は残してある。
        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                          &kp F12
            >;
        };

        NUM {
            bindings = <
&kp EXCLAMATION  &kp JP_DQUOTE  &kp HASH  &kp DOLLAR   &kp PERCENT                                     &kp JP_AMPERSAND  &kp JP_QUOTE       &kp JP_LPAREN    &kp JP_RPAREN    &kp MINUS
&trans           &trans         &trans    &kp JP_PLUS  &kp ASTERISK  &mkp MB3       &kp JP_UNDERSCORE  &kp SEMICOLON     &kp JP_COLON       &kp JP_LBRACKET  &kp JP_RBRACKET  &kp JP_CARET
&trans           &trans         &trans    &kp MINUS    &kp PERIOD    &kp EQUAL      &trans             &kp JP_AT         &kp JP_UNDERSCORE  &kp COMMA        &kp PERIOD       &kp SLASH
&trans           &trans         &trans    &trans       &trans        &trans         &trans             &trans                                                                 &kp JP_PIPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp JP_YEN                            &trans         &kp HOME        &kp UP_ARROW    &kp END          &trans
&kp SLASH   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp JP_COLON   &mkp MB3       &trans  &kp BACKSPACE  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &mo 7
&kp SLASH   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp SEMICOLON  &trans         &trans  &trans         &trans          &trans          &trans           &trans
&trans      &kp KP_NUMBER_0  &kp PERIOD       &kp COMMA        &trans         &kp MINUS      &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&to_layer_0 Q              &to_layer_0 W             &to_layer_0 E         &to_layer_0 R                         &to_layer_0 T                                               &to_layer_0 Y            &to_layer_0 U  &to_layer_0 I      &to_layer_0 O      &to_layer_0 P
&mt LEFT_CONTROL A         &to_layer_0 S             &to_layer_0 D         &to_layer_0 F                         &to_layer_0 G  &mkp MB3               &to_layer_0 MINUS     &to_layer_0 H            &to_layer_0 J  &to_layer_0 K      &to_layer_0 L      &lt_to_layer_0 5 ENTER
&mt_z_custom LEFT_SHIFT Z  &to_layer_0 X             &to_layer_0 C         &to_layer_0 V                         &to_layer_0 B  &to_layer_0 COLON      &to_layer_0 QUESTION  &to_layer_0 N            &to_layer_0 M  &mkp_exit_AML MB1  &mkp_exit_AML MB2  &lt 5 BACKSPACE
&to_layer_0 RIGHT_SHIFT    &to_layer_0 LEFT_COMMAND  &to_layer_0 LEFT_ALT  &mt_comand_custom LEFT_COMMAND LANG2  &lt 2 SPACE    &lt 3 TAB              &lt 3 SPACE           &mt RIGHT_COMMAND LANG1                                                       &to_layer_0 ESCAPE
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&kp C_VOLUME_UP    &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &kp LA(LS(T))                                                        &kp LA(LS(Y))  &trans                  &kp LC(UP_ARROW)    &kp LA(LG(LS(L)))    &trans
&kp C_VOLUME_DOWN  &kp LC(LEFT_ARROW)    &kp LC(LEFT_ARROW)    &trans  &trans                      &kp LG(NUMBER_0)                 &trans  &trans         &kp LG(LA(UP_ARROW))    &kp LC(DOWN_ARROW)  &kp LC(RIGHT_ARROW)  &trans
&kp K_MUTE         &trans                &trans                &trans  &kp LC(LG(LA(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT_ARROW)))      &trans  &trans         &kp LA(LG(DOWN_ARROW))  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &trans
&kp LA(LS(LG(M)))  &kp LA(LS(LG(V)))     &trans                &trans  &trans                      &trans                           &trans  &trans                                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(JP_PLUS)>;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        Sym_Num {
            bindings = <
&trans  &kp N7  &kp N8  &kp N9  &trans                      &kp JP_AMPERSAND  &kp JP_QUOTE     &kp JP_EQUAL      &kp JP_CARET       &kp JP_YEN
&trans  &kp N4  &kp N5  &kp N6  &trans  &trans      &trans  &kp JP_PLUS       &kp JP_TILDE     &kp JP_PIPE       &kp JP_AT          &kp JP_COLON
&trans  &kp N1  &kp N2  &kp N3  &trans  &trans      &trans  &none             &kp JP_ASTERISK  &kp JP_BACKQUOTE  &kp JP_UNDERSCORE  &kp SEMICOLON
&trans  &kp N0  &trans  &trans  &trans  &trans      &trans  &trans                                                                  &trans
            >;
        };

        // layer_8 — `&lt 8 TAB`（左親指）で入る。中括弧・不等号と F キー。
        //
        // F1〜F12 をここへ置いた（2026-08-07）。FUNCTION レイヤー(1) に定義は
        // あるが、`&mo 1` / `&lt 1` / `&to 1` がキーマップ中に1つも無く到達手段が
        // 存在しなかったため、F キーが打てない状態だった。
        // 入口が左親指なので、押しやすいよう右手側にまとめている。
        layer_8 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &kp F1  &kp F2  &kp F3               &kp F4               &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &kp F6   &kp F7  &kp F8  &kp LS(JP_LBRACKET)  &kp LS(JP_RBRACKET)  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp F9   &kp F10 &kp F11 &kp LESS_THAN        &kp GREATER_THAN     &kp F12
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans                                                    &trans
            >;
        };
    };
};
